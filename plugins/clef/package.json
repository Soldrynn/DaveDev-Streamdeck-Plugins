{
  "name": "stream-deck-clef",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Clef provides Stream Deck + controls for Apple Music for Windows on Windows 11.",
  "license": "Apache-2.0",
  "author": "DaveDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soldrynn/DaveDev-Streamdeck-Plugins.git"
  },
  "bugs": {
    "url": "https://github.com/Soldrynn/DaveDev-Streamdeck-Plugins/issues"
  },
  "homepage": "https://github.com/Soldrynn/DaveDev-Streamdeck-Plugins#readme",
  "keywords": [
    "clef",
    "music-controls",
    "elgato",
    "stream-deck",
    "stream-deck-plus",
    "windows"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:helper": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "build": "npm run build:plugin && npm run build:helper",
    "check": "tsc --noEmit && node --experimental-strip-types --test tests/*.test.ts && node scripts/validate-assets.mjs && node scripts/validate-release.mjs && node scripts/smoke-plugin-bundle.mjs",
    "validate": "streamdeck validate com.davedev.clef.sdPlugin --no-update-check",
    "pack": "streamdeck pack com.davedev.clef.sdPlugin --output dist --force --no-update-check"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@elgato/streamdeck": "^2.1.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24"
  }
}
